<?xml version="1.0" encoding="UTF-8"?>
<uml:Model xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML"
    xmi:id="shop-model" name="Shop">
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="string-type" name="String"/>
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="boolean-type" name="Boolean"/>
  <packagedElement xmi:type="uml:Class" xmi:id="catalog-class" name="Catalog">
    <ownedAttribute xmi:id="catalog-name" name="name" type="string-type"/>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="item-class" name="Item">
    <ownedAttribute xmi:id="item-name" name="name" type="string-type"/>
    <ownedAttribute xmi:id="item-active" name="active" type="boolean-type"/>
  </packagedElement>
  <packagedElement xmi:type="uml:Association" xmi:id="catalog-items-association"
      name="catalogItems" memberEnd="catalog-end items-end">
    <ownedEnd xmi:id="catalog-end" name="catalog" type="catalog-class">
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="catalog-lower" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="catalog-upper" value="1"/>
    </ownedEnd>
    <ownedEnd xmi:id="items-end" name="items" type="item-class">
      <lowerValue xmi:type="uml:LiteralInteger" xmi:id="items-lower" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="items-upper" value="*"/>
    </ownedEnd>
  </packagedElement>
</uml:Model>
